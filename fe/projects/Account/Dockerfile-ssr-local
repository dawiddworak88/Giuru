FROM node:24-alpine

RUN apk update && apk add python3 make g++

RUN mkdir -p /home/node/account-web-react-ssr/node_modules && chown -R node:node /home/node/account-web-react-ssr

WORKDIR /home/node/account-web-react-ssr

COPY projects/Account/package*.json ./

USER root

RUN npm install --legacy-peer-deps

USER node

# fe/shared is referenced from the sources by paths that climb out of the project directory
# (server/bootstrap.js resolves "../../../shared"). Landing it two levels above the project root
# reproduces the repo layout, where fe/projects/<Project> and fe/shared are siblings under fe.
COPY --chown=node:node shared /home/shared

COPY --chown=node:node projects/Account .

# Fail the build here rather than at container start if that layout ever drifts.
RUN node -e "require(require('path').resolve('server', '../../../shared/build/registerSharedModuleResolution.cjs'))"

ENV NODE_ENV=development

EXPOSE 3000

CMD ["npm", "run", "watch-ssr"]